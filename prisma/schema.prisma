// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for Discord authentication
model User {
  id            String    @id @default(cuid())
  discordId     String    @unique
  email         String?   @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  blogComments  BlogComment[]
}

// Product model
model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String    @db.Text
  price         Float
  category      String
  images        String[]
  sizes         String[]
  colors        String[]
  badge         String?
  inStock       Boolean   @default(true)
  featured      Boolean   @default(false)
  features      String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderItems    OrderItem[]

  @@index([category])
  @@index([slug])
}

// Blog Post model
model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String    @db.Text
  content       String    @db.Text
  author        String
  category      String
  image         String
  featured      Boolean   @default(false)
  tags          String[]
  publishedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  comments      BlogComment[]

  @@index([category])
  @@index([slug])
}

// Blog Comment model
model BlogComment {
  id            String    @id @default(cuid())
  content       String    @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId        String
  post          BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

// Order model
model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  stripeSessionId   String?     @unique
  stripePaymentId   String?

  // Customer info
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  customerEmail     String
  customerName      String?

  // Order details
  subtotal          Float
  discount          Float       @default(0)
  shipping          Float
  total             Float
  status            OrderStatus @default(PENDING)

  // Discount code
  discountCodeId    String?
  discountCode      DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountCodeUsed  String?

  // Shipping address
  shippingAddress   Json?

  // Tracking
  trackingNumber    String?

  // Timestamps
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?

  items             OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([discountCodeId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Order Item model
model OrderItem {
  id            String    @id @default(cuid())

  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId     String
  product       Product   @relation(fields: [productId], references: [id])

  name          String
  price         Float
  quantity      Int
  size          String?
  color         String?
  image         String

  createdAt     DateTime  @default(now())

  @@index([orderId])
  @@index([productId])
}

// Discount Code model
model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?

  // Discount details
  type          DiscountType
  value         Float     // Percentage (0-100) or fixed amount in dollars

  // Usage limits
  maxUses       Int?      // Null = unlimited
  usedCount     Int       @default(0)

  // Validity
  validFrom     DateTime  @default(now())
  validUntil    DateTime?

  // Restrictions
  minPurchase   Float?    // Minimum order amount required
  active        Boolean   @default(true)

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]

  @@index([code])
  @@index([active])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Site Settings model for configurable site-wide settings
model SiteSettings {
  id            String    @id @default("default")

  // Intro Video settings
  introVideoEnabled     Boolean   @default(true)
  introVideoUrl         String?
  introVideoSkipSeconds Int       @default(5)

  // Site Config settings
  siteName              String    @default("The Village")
  siteDescription       String?   @db.Text
  maintenanceMode       Boolean   @default(false)
  maintenanceMessage    String?   @db.Text
  contactEmail          String?
  socialDiscord         String?
  socialTwitter         String?
  socialInstagram       String?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
